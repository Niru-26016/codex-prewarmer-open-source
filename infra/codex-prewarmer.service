[Unit]
Description=Codex Prewarmer isolated VM runner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
DynamicUser=yes
StateDirectory=codex-prewarmer
StateDirectoryMode=0700
WorkingDirectory=/opt/codex-prewarmer/current
LoadCredential=runner.json:/etc/codex-prewarmer/runner.json
Environment=HOME=/var/lib/codex-prewarmer
Environment=PATH=/opt/codex-prewarmer/current/vendor/bin:/opt/codex-prewarmer/current/runtime/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=64
ExecStartPre=/opt/codex-prewarmer/current/vendor/bin/codex --version
ExecStart=/opt/codex-prewarmer/current/runtime/bin/node /opt/codex-prewarmer/current/scripts/vm-runner.mjs ${CREDENTIALS_DIRECTORY}/runner.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=150
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=512M
CPUQuota=25%
CPUWeight=10
IOWeight=10
TasksMax=128
LimitCORE=0
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-prewarmer

[Install]
WantedBy=multi-user.target
